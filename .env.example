# Set this to the deployed frontend origin, for example:
# PUBLIC_APP_URL=https://your-domain.com
# Use "bypass" only with DEV_PAYMENT_BYPASS_ENABLED=true in Edge Functions.
# Production must use Razorpay verification.
VITE_PAYMENT_MODE=razorpay